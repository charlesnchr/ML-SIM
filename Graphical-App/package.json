{
  "name": "ml-sim",
  "productName": "ML-SIM",
  "description": "Deep neural network for reconstruction of structured illumination microscopy images",
  "license": "GPL-3.0-only",
  "author": "Charles N. Christensen",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "electron/main.js",
  "scripts": {
    "setup-engine": "node scripts/setup-engine.js",
    "download-models": "node scripts/download-models.js",
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "start": "concurrently -k \"vite\" \"wait-on tcp:4001 && cross-env MLSIM_DEV_SERVER=http://localhost:4001 electron .\"",
    "app": "vite build && electron .",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "@electron/remote": "^2.1.4",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@blueprintjs/core": "^3.54.0",
    "@fontsource/roboto": "^5.3.0",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^7.0.3",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-router-dom": "^5.3.4",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.ml-sim.app",
    "files": [
      "build/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "pyengine",
        "to": "pyengine",
        "filter": [
          "pysrc/*.py",
          "requirements.txt"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.education"
    },
    "win": {
      "icon": "graphics/icons/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Science"
    }
  }
}
